# ── StudySnap environment ─────────────────────────────────────────────
# Server
PORT=3000
NODE_ENV=development
# Secret used to sign session tokens (change this!)
JWT_SECRET=change-me-to-a-long-random-string

# ── AI provider (OpenAI-compatible Chat Completions API) ──────────────
# Any OpenAI-compatible endpoint works: OpenAI, Groq, Together, Ollama, etc.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Free-tier limits (per user, per day)
FREE_DAILY_AI_CALLS=25
FREE_MAX_STUDY_SETS=5
MAX_UPLOAD_MB=10
